{
  "version": 2,
  "env": {
    "HOME_API_URL": "https://turtle-spreading-enhancement-airport.trycloudflare.com"
  },
  "rewrites": [
    {
      "source": "/v1/billing/webhook",
      "destination": "/api/stripe-webhook"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api/v1?path=$1"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/meta",
      "destination": "/api/meta"
    }
  ]
}
